flowchart LR
    subgraph robot["真机已验证：2026-09-24 静止 Trial 0"]
        RGB["Astra RGB + 注册 Depth"] --> SYNC["时间戳同步与有效深度"]
        SYNC --> YOLO["YOLO-World 检测"]
        YOLO --> GEO["Color CameraInfo 反投影 + TF"]
        GEO --> MAP["odom_combined 语义对象地图"]
        MAP --> PUB["14 对象 + 实收 28 Marker"]
    end

    subgraph gate["真机准入边界"]
        AUDIT["相机 TF 单 parent：PASS"] --> PROJ["Color K + 注册深度投影：PASS"]
        PROJ --> STATIC["静止 Trial 0：PASS，413/388 帧"]
        STATIC --> MOBILE["Trial 1–3 / 运动关联：待验证"]
        DK["Depth K 含 NaN：其他消费者待核实"] -.-> MOBILE
    end

    subgraph thesis["论文模块：受控故障 smoke"]
        I["VLN 指令 + MP3D 观测"] --> P["语义感知与进度跟踪"]
        P --> R["原始历史"]
        R --> G{"可靠性门禁"}
        G -->|"可信"| T["可信聚合状态"]
        G -->|"不可信"| X["隔离错误状态"]
        T --> CHECK["指令 / 历史 / 转移一致性"]
        I --> CHECK
        CHECK --> D["诊断与 Last Reliable State 锚点"]
    end

    AUDIT --> GEO
    PROJ --> GEO
    PUB -.->|"尚未接入真机诊断"| CHECK
    D -.->|"尚未实机验证"| E["SimpleNav / Nav2 / 底盘恢复执行"]
    MOBILE -.->|"尚未准入"| E

    classDef input fill:#eaf2f6,stroke:#0e3b5d,color:#072d48,stroke-width:1.5px;
    classDef core fill:#fff2e8,stroke:#ee8234,color:#7a3510,stroke-width:1.5px;
    classDef memoryNode fill:#f4f8fa,stroke:#47758f,color:#0e3b5d,stroke-width:1.5px;
    classDef boundary fill:#fff0ef,stroke:#c84a42,color:#6d2420,stroke-width:1.5px;
    class RGB,SYNC,YOLO,GEO,I input;
    class P,CHECK,D,PROJ,STATIC core;
    class R,G,T,MAP,PUB memoryNode;
    class X,E,MOBILE,DK boundary;
    class AUDIT input;
    style robot fill:#eaf2f6,stroke:#0e3b5d,stroke-width:1px
    style gate fill:#fff9f4,stroke:#ee8234,stroke-width:1px
    style thesis fill:#fff9f4,stroke:#ee8234,stroke-width:1px
